{
  "productName": "Projscope Tasks",
  "directories": {
    "output": "release/"
  },
  "publish": {
    "provider": "github",
    "owner": "jviaches",
    "repo": "projscope-tasks-source"
  },
    "files": [
        "**/*",
        "!**/*.ts",
        "!*.code-workspace",
        "!LICENSE.md",
        "!package.json",
        "!package-lock.json",
        "!src/",
        "!e2e/",
        "!hooks/",
        "!angular.json",
        "!_config.yml",
        "!karma.conf.js",
        "!tsconfig.json",
        "!tslint.json"
    ],
  "win": {
    "icon": "dist/assets/icons",
    "extraFiles": [
      {
        "from": "node_modules/electron/dist/ffmpeg.dll",
        "to": "ffmpeg.dll"
      }
    ],
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "mac": {
    "icon": "dist/assets/icons",
    "target": [
      "dmg",
      "zip"
    ]
  },
  "linux": {
    "icon": "dist/assets/icons/favicon.512x512.png",
    "target": [
      "AppImage"
    ]
  }
}
